DB_HOST=
POSTGRES_SERVER=
DB_PORT=
POSTGRES_PORT=
DB_NAME=
POSTGRES_DB=
DB_USERNAME=
POSTGRES_USER=
DB_PASSWORD=
POSTGRES_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=
ACCESS_TOKEN_EXPIRE_MINUTES_LONG=
JWT_SECRET=
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_EMAIL=
SECRET=123456
AUTH0_CLIENT_ID=fitness-api-01
AUTH0_CLIENT_SECRET=fitness-api-secret-01
AUTH0_DOMAIN=http://127.0.0.1:8000
REDIS_URL=redis://redis:6379/0
ADMIN=
PWR=

# Google OAuth (register at https://console.cloud.google.com/)
# GOOGLE_REDIRECT_URI must be one of the "Authorized redirect URIs" of the
# OAuth client. Google only accepts plain http for localhost — every other host
# must be https on a real domain. A bare IP address is rejected outright with
# "Error 400: invalid_request".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# Deep link the Flutter app listens on for the OAuth hand-back
# (used when the app calls /google/authorize?client=mobile).
# Must match `_callbackUrlScheme` in app/lib/presentation/screens/login_screen.dart
# and the intent filter in app/android/app/src/main/AndroidManifest.xml.
GOOGLE_MOBILE_REDIRECT_URI=fitnesscoach://auth/callback

# Frontend URL used in verification & reset email links
FRONTEND_URL=http://localhost:3000

# Long-lived token expiry (seconds); default 30 days
ACCESS_TOKEN_EXPIRE_MINUTES_LONG=43200

# Media storage for coach avatars.
# MEDIA_ROOT is a path inside the container; leave unset to use <project>/media.
# PUBLIC_BASE_URL must be the externally reachable origin, because avatar URLs
# are stored absolute in the database.
MEDIA_ROOT=/app/media
PUBLIC_BASE_URL=http://207.126.161.154:8000
